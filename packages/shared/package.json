    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jandi/eslint-config": "workspace:*",
    "@jandi/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
