{
  "name": "jandi-moviehub",
  "private": true,
  "description": "Jandi MovieHub — Your Movie Night. Everyone's Invited.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "deploy:web": "node scripts/deploy-vercel.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @jandi/api test:integration",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @jandi/api db:migrate",
    "db:deploy": "pnpm --filter @jandi/api db:deploy",
    "db:seed": "pnpm --filter @jandi/api db:seed",
    "db:reset": "pnpm --filter @jandi/api db:reset",
    "media:generate": "node scripts/generate-demo-media.mjs",
    "admin:bootstrap": "pnpm --filter @jandi/api admin:bootstrap",
    "perf": "node tests/performance/run.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "ffmpeg-static": "5.3.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "ffmpeg-static",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": "2.5.0",
      "js-yaml": "5.5.0",
      "deepmerge-ts": "8.0.2"
    }
  }
}
