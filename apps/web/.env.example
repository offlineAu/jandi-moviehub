# Copy to apps/web/.env.local
# Where the Next.js server proxies /api/v1/* (server-side only).
API_INTERNAL_URL=http://localhost:4000
# Socket.IO origin used by the browser (the API). In production behind the reverse proxy, use the site origin.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Optional extra development hostnames (no scheme or port), e.g. a development tunnel.
# The dev server automatically includes this Mac's local IPv4 interface addresses.
WEB_DEV_ORIGINS=

# Comma-separated HTTPS origins or subdomain patterns for experimental HLS playback.
KISSKH_MEDIA_ORIGINS=
