# ── Jandi MovieHub API environment ──
# Copy to apps/api/.env. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=false

DATABASE_URL=postgresql://jandi:jandi_dev_password@localhost:5432/jandi_moviehub
REDIS_URL=redis://localhost:6379/0

WEB_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

COOKIE_SECURE=false
SESSION_TTL_DAYS=30
GUEST_SESSION_TTL_HOURS=24
# Generate with: openssl rand -base64 48
MEDIA_SIGNING_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# auto = TMDB when a key is present, else the local demo catalog
CATALOG_PROVIDER=auto
TMDB_API_KEY=
TMDB_READ_TOKEN=
WATCHMODE_API_KEY=

# dev = local preview (development only); resend = HTTPS API; smtp = SMTP delivery
MAIL_TRANSPORT=dev
SMTP_URL=
RESEND_API_KEY=
# Without a verified domain, Resend's onboarding@resend.dev sends only to your Resend account email.
MAIL_FROM=Jandi MovieHub <no-reply@jandi.local>

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OTEL_EXPORTER_OTLP_ENDPOINT=
ERROR_WEBHOOK_URL=
# Exposes /api/v1/dev/mail (never enabled in production)
ENABLE_DEV_ROUTES=true
