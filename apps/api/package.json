{
  "name": "@jandi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --builder swc --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "db:test:migrate": "node scripts/with-test-env.mjs prisma migrate deploy"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@aws-sdk/s3-request-presigner": "3.1160.0",
    "@jandi/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.8",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jandi/eslint-config": "workspace:*",
    "@jandi/typescript-config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "chokidar": "^5.0.0",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
}
